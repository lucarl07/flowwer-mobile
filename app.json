{
  "expo": {
    "name": "Flowwer",
    "slug": "flowwer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flowwermobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-font", 
        {
          "fonts": [
            "./assets/fonts/Buenard/Buenard.ttf",
            "./assets/fonts/Playwrite_DK_Loopet/PlaywriteDKLoopet.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Cantarell",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Cantarell/Cantarell-Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/Cantarell/Cantarell-Bold.ttf",
                    "weight": 700,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/Cantarell/Cantarell-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Cantarell/Cantarell-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Cantarell/Cantarell-Regular.ttf",
              "./assets/fonts/Cantarell/Cantarell-Bold.ttf",
              "./assets/fonts/Cantarell/Cantarell-Italic.ttf",
              "./assets/fonts/Cantarell/Cantarell-BoldItalic.ttf"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
